APP_NAME="CrackSense AI"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database (Local SQLite or Supabase PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./cracksense.db"
# Supabase PostgreSQL Pooler connection string:
# DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

SECRET_KEY="cracksense-dev-secret-key-change-in-production"
UPLOAD_DIRECTORY="storage/uploads"
REPORT_DIRECTORY="storage/reports"

# Trained Model Paths
RESNET_MODEL_PATH="models/best_resnet18.pth"
YOLO_MODEL_PATH="models/best_yolo.pt"
UNET_MODEL_PATH=""

# Roboflow Universe API Keys
ROBOFLOW_API_KEY=""
ROBOFLOW_PUBLISHABLE_KEY=""
ROBOFLOW_WORKSPACE=""

# Supabase Cloud Database & Storage API (Dashboard -> Project Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","*"]
