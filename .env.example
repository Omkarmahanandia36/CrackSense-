APP_NAME="CrackSense AI"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (supports SQLite or PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./cracksense.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cracksense_db"

SECRET_KEY="cracksense-super-secret-key-change-in-production"
UPLOAD_DIRECTORY="storage/uploads"
REPORT_DIRECTORY="storage/reports"

# Model Checkpoints (optional, falls back to initialized/pretrained model)
RESNET_MODEL_PATH=""
YOLO_MODEL_PATH=""
UNET_MODEL_PATH=""

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","*"]
