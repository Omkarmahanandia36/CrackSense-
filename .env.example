APP_NAME="CrackSense AI"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL default with automatic SQLite fallback)
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/cracksense_db"
# Fallback SQLite path if PostgreSQL is offline:
# SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./cracksense.db"

# JWT Authentication
SECRET_KEY="cracksense-super-secret-jwt-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Paths
UPLOAD_DIRECTORY="storage/uploads"
REPORT_DIRECTORY="storage/reports"

# Model Checkpoints (Leave empty or set path to best_resnet18.pth)
RESNET_MODEL_PATH="models/best_resnet18.pth"
YOLO_MODEL_PATH=""
UNET_MODEL_PATH=""

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","*"]
