{
  "name": "cracksense-desktop",
  "version": "1.3.0",
  "description": "CrackSense AI - Concrete Surface Inspection Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:win:installer": "electron-builder --win nsis",
    "dist:win:publish": "electron-builder --win --publish always",
    "release:frontend": "cd frontend && npm run build",
    "release:win": "npm run release:frontend && electron-builder --win nsis --publish never",
    "release:android:sync": "npm run release:frontend && cd frontend && npx cap sync android",
    "release:android:build": "npm run release:android:sync && cd frontend/android && gradlew.bat assembleRelease",
    "publish:update": "python ../scripts/publish_update.py"
  },
  "build": {
    "appId": "ai.cracksense.desktop",
    "productName": "CrackSense AI",
    "directories": {
      "output": "dist-electron"
    },
    "publish": {
      "provider": "github",
      "owner": "Omkarmahanandia36",
      "repo": "CrackSense-"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^26.7.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}